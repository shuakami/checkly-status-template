{
  "name": "checkly-status-template",
  "private": false,
  "version": "1.0.0",
  "description": "A reusable Next.js status page template powered by Checkly",
  "keywords": [
    "checkly",
    "nextjs",
    "status-page",
    "template",
    "monitoring"
  ],
  "homepage": "https://github.com/shuakami/checkly-status-template",
  "bugs": {
    "url": "https://github.com/shuakami/checkly-status-template/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/shuakami/checkly-status-template.git"
  },
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack --hostname 0.0.0.0 --port 3000",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0 --port 3000",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "validate": "npm run typecheck && npm run build"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "motion": "^12.35.1",
    "next": "16.1.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sharp": "^0.34.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2"
  }
}
